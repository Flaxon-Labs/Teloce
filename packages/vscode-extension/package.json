{
  "name": "teloce-vscode",
  "private": true,
  "displayName": "Teloce",
  "description": "Teloce template language support for VS Code",
  "version": "0.1.2",
  "type": "module",
  "publisher": "Flaxon-vscode",
  "icon": "./icons/icons.jpeg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aldanedev-create/telonce",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "teloce",
    "template",
    "python",
    "flask",
    "django",
    "fastapi"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "teloce",
        "aliases": [
          "Teloce",
          "teloce"
        ],
        "extensions": [
          ".vel",
          ".teloce"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vel-light.svg",
          "dark": "./icons/vel-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "teloce",
        "scopeName": "source.teloce",
        "path": "./syntaxes/teloce.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "teloce.format",
        "title": "Format Teloce Template",
        "category": "Teloce"
      },
      {
        "command": "teloce.validate",
        "title": "Validate Teloce Template",
        "category": "Teloce"
      },
      {
        "command": "teloce.openDebugger",
        "title": "Open Teloce Debugger",
        "category": "Teloce"
      },
      {
        "command": "teloce.stopDebugger",
        "title": "Stop Debugger",
        "category": "Teloce"
      },
      {
        "command": "teloce.copyDebuggerScript",
        "title": "Copy Debugger Script Tag",
        "category": "Teloce"
      }
    ],
    "keybindings": [
      {
        "command": "teloce.format",
        "key": "shift+alt+f",
        "when": "editorLangId == teloce"
      }
    ],
    "configuration": {
      "title": "Teloce",
      "properties": {
        "teloce.format.indentSize": {
          "type": "number",
          "default": 2,
          "description": "Number of spaces for indentation"
        },
        "teloce.format.useTabs": {
          "type": "boolean",
          "default": false,
          "description": "Use tabs instead of spaces"
        },
        "teloce.validate.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable validation"
        },
        "teloce.completion.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable autocompletion"
        },
        "teloce.debugger.host": {
          "type": "string",
          "default": "localhost",
          "description": "Debugger host"
        },
        "teloce.debugger.port": {
          "type": "number",
          "default": 9000,
          "description": "Debugger port"
        },
        "teloce.typescript.enable": {
          "type": "boolean",
          "default": true,
          "description": "Type-check <script lang=\"ts\"> blocks in .vel and component-style .html files, and provide TypeScript hover, completion and go-to-definition there."
        },
        "teloce.typescript.strict": {
          "type": "boolean",
          "default": true,
          "description": "Use TypeScript's strict mode for <script lang=\"ts\"> blocks. A tsconfig.json in the workspace root takes precedence."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "vscode:prepublish": "pnpm run build",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bundle": "node scripts/smoke-bundle.cjs",
    "test:release": "pnpm run build && pnpm run test && pnpm run test:bundle"
  },
  "dependencies": {
    "@teloce/debugger": "workspace:^",
    "@teloce/language-service": "workspace:^"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.32.0",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "activationEvents": [
    "onLanguage:teloce",
    "onLanguage:html"
  ]
}
